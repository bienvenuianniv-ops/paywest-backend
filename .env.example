PORT=5000
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Base separee utilisee par `npm test` (NODE_ENV=test) — ne doit jamais pointer vers la prod
TEST_DATABASE_URL=postgresql://user:password@host/dbname_test?sslmode=require
JWT_SECRET=
RESEND_API_KEY=
WAVE_WEBHOOK_SECRET=
ORANGE_WEBHOOK_SECRET=
# Optionnel — active le suivi d'erreurs Sentry si defini
SENTRY_DSN=
